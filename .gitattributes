# The Gradle wrapper scripts must keep the line endings their interpreter expects.
# gradlew is run by sh on Linux, macOS and CI, where CRLF makes it fail with a
# "bad interpreter" error that gives no hint about line endings.
gradlew      text eol=lf
gradlew.bat  text eol=crlf

# Never let a text filter corrupt binaries.
*.jar  binary
*.png  binary
*.ogg  binary

# Canonical generators and source-bound runtime manifests hash raw UTF-8/LF.
# A Windows checkout must not turn a normal writer's bytes into a different artifact.
common/src/main/resources/**/*.json text eol=lf
docs/tiers/t0-economy.json text eol=lf
docs/assets/t0-experience-visual.json text eol=lf
