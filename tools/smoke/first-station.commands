forceload add 0 0
setblock 8 70 8 grindless:station_berth
execute if block 8 70 8 grindless:station_berth run say BERTH-OK
summon grindless:supraluminal_station 8.5 71 8.5
execute as @e[type=grindless:supraluminal_station,limit=1] run say STATION-OK
setblock 8 72 8 grindless:starward_link
execute if block 8 72 8 grindless:starward_link run say LINK-STAYS
