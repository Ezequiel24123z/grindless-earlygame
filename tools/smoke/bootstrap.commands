say WAIT-INPUT
execute if data block 8 70 8 Input[{id:"grindless:data_core"}] run say CORE-IN
data merge block 8 70 8 {Energy:{FluxStored:16L},Progress:599.0d}
say WAIT-CALIBRATION
say WAIT-CALIBRATION
say WAIT-CALIBRATION
execute if data block 8 69 8 Items[{id:"grindless:calibrated_data_core"}] run say CALIBRATED-OUT
setblock 12 70 8 grindless:research_terminal[facing=south,status=idle]{Input:[{Slot:0b,id:"grindless:advanced_data_core",Count:1b}]}
setblock 12 69 8 minecraft:hopper
say WAIT-LEGACY
say WAIT-LEGACY
execute if data block 12 69 8 Items[{id:"grindless:advanced_data_core"}] run say LEGACY-OUT
setblock 16 70 8 grindless:hand_crank_dynamo[facing=east,status=idle]
setblock 17 70 8 grindless:crude_extractor[facing=east,status=idle]
