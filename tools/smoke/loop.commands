forceload add 0 0
setblock 8 70 8 minecraft:air
setblock 8 71 8 minecraft:air
setblock 8 72 8 minecraft:air
setblock 8 70 8 grindless:flux_pylon_mk1[status=idle]
execute if block 8 71 8 grindless:flux_pylon_shaft run say SHAFT-MID
