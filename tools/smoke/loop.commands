execute unless block 8 71 8 grindless:flux_pylon_shaft run say SHAFT-GONE
setblock 8 70 8 grindless:crude_extractor[facing=south,status=idle]
execute if block 8 70 8 grindless:crude_extractor run say EXTRACTOR-OK
