forceload add 0 0
setblock 8 70 8 minecraft:air
setblock 8 71 8 minecraft:air
setblock 8 70 8 grindless:thermal_generator[facing=south,status=idle]
execute if block 8 70 8 grindless:thermal_generator run say GEN-OK
data get block 8 70 8
setblock 8 71 8 minecraft:hopper{Items:[{Slot:0b,id:"minecraft:coal",Count:1b}]}
