forceload add 0 0
say WAIT-CHUNK
summon minecraft:item 8 100 8 {Item:{id:"grindless:voltaic_helmet",Count:1b}}
execute if entity @e[type=item,nbt={Item:{id:"grindless:voltaic_helmet"}}] run say HELMET-OK
summon minecraft:item 8 100 8 {Item:{id:"grindless:voltaic_chestplate",Count:1b}}
execute if entity @e[type=item,nbt={Item:{id:"grindless:voltaic_chestplate"}}] run say CHEST-OK
summon minecraft:item 8 100 8 {Item:{id:"grindless:voltaic_leggings",Count:1b}}
execute if entity @e[type=item,nbt={Item:{id:"grindless:voltaic_leggings"}}] run say LEGS-OK
summon minecraft:item 8 100 8 {Item:{id:"grindless:voltaic_boots",Count:1b}}
execute if entity @e[type=item,nbt={Item:{id:"grindless:voltaic_boots"}}] run say BOOTS-OK
summon minecraft:item 8 100 8 {Item:{id:"grindless:flux_cell",Count:1b}}
execute if entity @e[type=item,nbt={Item:{id:"grindless:flux_cell"}}] run say CELL-OK
kill @e[type=item]
