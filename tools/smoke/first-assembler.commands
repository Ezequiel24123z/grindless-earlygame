forceload add 0 0
setblock 8 68 8 minecraft:stone
setblock 8 69 8 minecraft:air
setblock 8 70 8 minecraft:air
setblock 8 71 8 minecraft:air
setblock 8 70 8 grindless:press[facing=south,status=idle]
execute if block 8 70 8 grindless:press run say PRESS-OK
item replace block 8 70 8 container.1 with grindless:plate_die
data get block 8 70 8
setblock 8 69 8 minecraft:hopper
say WAIT-HOPPER
say WAIT-HOPPER
execute if data block 8 70 8 Items[{id:"grindless:plate_die"}] run say DIE-STAYS
setblock 8 71 8 minecraft:hopper{Items:[{Slot:0b,id:"minecraft:iron_ingot",Count:1b}]}
say WAIT-HOPPER
say WAIT-HOPPER
execute if data block 8 70 8 Items[{id:"minecraft:iron_ingot"}] run say INGOT-IN
setblock 10 70 8 grindless:assembler[facing=south,status=idle]
execute if block 10 70 8 grindless:assembler run say ASSEMBLER-OK
item replace block 10 70 8 container.0 with minecraft:glass 2
item replace block 10 70 8 container.1 with minecraft:copper_ingot 2
item replace block 10 70 8 container.2 with minecraft:redstone 2
item replace block 10 70 8 container.3 with grindless:calibrated_data_core
execute if data block 10 70 8 {Recipe:"assemble/relay_matrix"} run say MATRIX-RECIPE-OK
