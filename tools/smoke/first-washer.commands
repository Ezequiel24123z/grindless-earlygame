forceload add 0 0
setblock 8 68 8 minecraft:stone
setblock 8 69 8 minecraft:air
setblock 8 70 8 minecraft:air
setblock 8 71 8 minecraft:air
setblock 10 70 8 minecraft:air
setblock 8 70 8 grindless:chemical_washer[facing=south,status=idle]
execute if block 8 70 8 grindless:chemical_washer run say WASHER-OK
setblock 8 71 8 minecraft:hopper{Items:[{Slot:0b,id:"grindless:iron_crushed",Count:8b}]}
say WAIT-HOPPER
say WAIT-HOPPER
execute if data block 8 70 8 Items[{id:"grindless:iron_crushed"}] run say CRUSHED-IN
setblock 10 70 8 grindless:basic_tank[facing=south,status=idle]{Fluid:{Id:"minecraft:water",Amount:2000,Temp:20.0d,Pressure:0.1d}}
execute if block 10 70 8 grindless:basic_tank run say TANK-WATER
summon minecraft:item 8 100 8 {Item:{id:"grindless:iron_washed_crushed",Count:1b}}
execute if entity @e[type=item,nbt={Item:{id:"grindless:iron_washed_crushed"}}] run say WASHED-OK
kill @e[type=item]
